LOCAL_API_KEY=<sk-local-change-me>
VELA_LLM_HOST=127.0.0.1
VELA_LLM_PORT=4000
VELA_LLM_MODELS_CONFIG=models.toml
VELA_LLM_LITELLM_CONFIG=litellm.yaml
VELA_LLM_LOG_LEVEL=info

